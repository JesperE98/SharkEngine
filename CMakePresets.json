{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (x64)",
      "description": "Generates a Visual Studio 2026 solution in build/vs2026",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "description": "Generates a Visual Studio 2022 solution in build/vs2022",
      "inherits": "windows-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "ninja-msvc-base",
      "hidden": true,
      "inherits": "windows-base",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug (MSVC x64)",
      "description": "For Visual Studio 'Open Folder', VS Code and CLion. Needs an MSVC developer environment.",
      "inherits": "ninja-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release (MSVC x64)",
      "description": "For Visual Studio 'Open Folder', VS Code and CLion. Needs an MSVC developer environment.",
      "inherits": "ninja-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "vs2026-debug",   "displayName": "Debug",   "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "displayName": "Release", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "vs2022-debug",   "displayName": "Debug",   "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "vs2022-release", "displayName": "Release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "ninja-debug",    "displayName": "Debug",   "configurePreset": "ninja-debug" },
    { "name": "ninja-release",  "displayName": "Release", "configurePreset": "ninja-release" }
  ]
}
